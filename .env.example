# ── LLM / Cloud Sentiment API ─────────────────────────────────────────────────
# Used for cloud-based sentiment analysis (Claude, GPT, Gemini, etc.)
API_KEY=your_api_key_here
API_URL=https://api.example.com/v1/chat/completions
MODEL=your_model_name

# ── Market Data ───────────────────────────────────────────────────────────────
# Polygon.io API key (optional — yfinance is used as primary source)
POLYGON_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Flask debug mode (never enable in production)
DEBUG=false

# Server port
PORT=9000
